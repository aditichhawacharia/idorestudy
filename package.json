{
  "name": "idorestudy-professional-adsense-ready",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && vite build && node scripts/prerender.mjs && node scripts/link-audit.mjs",
    "preview": "vite preview",
    "audit": "node scripts/syntax-check.mjs && node scripts/content-audit.mjs && npm run verify:static",
    "audit:prelaunch": "npm run audit && node scripts/prelaunch-audit.mjs",
    "check": "npm run audit && npm run build",
    "check:prelaunch": "npm run audit:prelaunch && npm run build",
    "build:client": "vite build",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "verify:static": "node scripts/generate-sitemap.mjs && node scripts/static-verify.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
